label start:

    # 사용자 이름 입력
    $ player_name = renpy.input("이름을 입력하세요.")
    $ player_name = player_name.strip()

    # 아무것도 입력하지 않으면 MC
    if player_name == "":
        $ player_name = "MC"

    jump intro


label intro:

    scene black with fade

    n "늦은 밤."

    n "[player_name][josa(player_name, '은', '는')] 학교가 끝난 뒤 혼자 집으로 돌아가고 있었다."

    # --------------------------------------------------
    # 2. 저주의 존재
    # --------------------------------------------------

    n "뒤를 돌아보자 처음 보는 검은 교복 차림의 사람이 서 있다."

    n "[player_name][josa(player_name, '이', '가')] 대답하기도 전에 그 사람이 빠르게 달려온다."

    exorcist "숙여!"

    n "[player_name][josa(player_name, '이', '가')] 몸을 숙이는 순간, 머리 위로 거대한 손이 지나간다."

    n "쿵!"

    n "벽이 그대로 부서진다."

    # --------------------------------------------------
    # 3. 예상 밖의 사고
    # --------------------------------------------------

    exorcist "여기 있어."

    exorcist "금방 끝내고 올 테니까."

    n "그는 그대로 괴물에게 달려든다."

    n "괴물의 몸에서 작은 입들이 수십 개 생겨난다."

    exorcist "젠장." 

    exorcist "생각보다 등급이 높아."
    
    n "괴물이 빠르게 그에게 달려든다."

    n "검은 교복의 남자는 벽에 부딪혀 쓰러진다."

    n "괴물이 천천히 주인공을 바라본다."

    # --------------------------------------------------
    # 4. 주인공의 능력
    # --------------------------------------------------

    n "괴물이 다가온다."

    mc "(다리가 움직이지 않아...)"

    n "그 순간."

    n "머릿속에서 이상한 감각이 느껴진다."

    centered "「멈춰」"

    mc "멈춰."

    n "순간, 괴물의 움직임이 멈춘다."

    exorcist "…설마."

    exorcist "말에 저주를 실었다고?"

    exorcist "다시 해!"

    mc "뭐를요?!"

    exorcist "방금 한 거!"

    exorcist "말해!"

    # ==================================================
    # [조음 방법 안내 화면]
    # ==================================================
    #
    # 여기서 스토리 화면을 잠시 멈추고
    # 목표 단어 "나무"의 조음 방법을 보여주는 화면 표시
    #
    # 예)
    # call screen articulation_guide("나무")
    #
    # 조음 방법을 모두 확인하면 다시 이 위치로 돌아옴
    #
    # ==================================================


    # --------------------------------------------------
    # 5. 첫 번째 발화
    # --------------------------------------------------

    n "[player_name][josa(player_name, '은', '는')] 방금 배운 입 모양을 떠올린다."

    mc "(천천히...)"

    mc "(배운 대로 말하면 돼.)"

    n "괴물이 다시 움직이기 시작한다."

    exorcist "지금이야!"

    # ==================================================
    # [음성 발음 기능 - 1번째 발화]
    # ==================================================
    #
    # 사용자가 마이크로 "나무"라고 말함
    #
    # 음성 인식 및 발음 성공 여부 확인
    #
    # 성공 시:
    #   - 몬스터 HP 감소
    #   - 성공 횟수 +1
    #
    # 실패 시:
    #   - 데미지 없음
    #   - 다시 발음하도록 재시도
    #
    # ==================================================

    mc "나무!"

    n "말이 끝나는 순간 괴물의 몸이 크게 흔들린다."

    n "검은 기운이 괴물의 몸에서 조금씩 흩어진다."

    exorcist "됐다!"

    exorcist "한 번 더!"

    # ==================================================
    # [음성 발음 기능 - 2번째 발화]
    # ==================================================
    #
    # 사용자가 다시 "나무" 발음
    #
    # 성공할 때까지 재시도
    #
    # 성공하면 몬스터 HP 추가 감소
    #
    # ==================================================

    mc "나무!"

    n "괴물이 뒤로 밀려난다."

    n "몸 곳곳에 금이 가듯 검은 기운이 갈라진다."

    exorcist "좋아."

    exorcist "마지막 한 번!"

    n "[player_name][josa(player_name, '은', '는')] 숨을 크게 들이마신다."

    mc "(마지막...)"

    # ==================================================
    # [음성 발음 기능 - 3번째 발화]
    # ==================================================
    #
    # 사용자가 세 번째로 "나무" 발음
    #
    # 성공 시:
    #   - 몬스터 HP = 0
    #   - 몬스터 처치
    #
    # ==================================================

    mc "나무!"

    n "순간 강한 충격이 괴물을 덮친다."

    n "괴물의 몸이 크게 뒤틀린다."

    n "그리고."

    n "쾅!"

    n "괴물의 몸이 검은 연기처럼 흩어지며 사라진다."


    # --------------------------------------------------
    # 6. 전투 종료
    # --------------------------------------------------

    n "검은 교복의 남자는 잠시 말없이 [player_name][josa(player_name, '을', '를')] 바라본다."

    mc "왜 그렇게 봐요?"

    exorcist "아무것도 모르는 것 같은데..."

    exorcist "말에 저주를 실을 수 있는 사람이 흔한 건 아니거든."

    mc "저주요?"

    exorcist "방금 네가 한 게 그거야."

    mc "전 그냥 '나무'라고 말했을 뿐인데요."

    exorcist "그러니까 더 문제지."

    n "검은 교복의 남자가 작게 한숨을 쉰다."

    exorcist "너."

    exorcist "나랑 주술학교에 좀 가봐야겠다."

    n "그날부터, [player_name][josa(player_name, '이의', '의')] 저주와 맞서는 새로운 일상이 시작된다."

    centered "Intro END"